prefix_rule(pattern=["terraform", "-chdir=iac", "apply"], decision="forbidden")
prefix_rule(pattern=["terraform", "-chdir=iac", "destroy"], decision="forbidden")
prefix_rule(pattern=["terraform", "apply"], decision="forbidden")
prefix_rule(pattern=["terraform", "destroy"], decision="forbidden")
