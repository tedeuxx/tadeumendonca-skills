{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://tadeumendonca.dev/schemas/worklog-snapshot-v1.json",
  "title": "Worklog sprint snapshot v1", "type": "object",
  "required": ["schema_version", "sprint", "timezone", "starts_at", "ends_at", "repositories", "counting_units"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1}, "sprint": {"type": "string", "minLength": 1}, "timezone": {"type": "string", "minLength": 1},
    "starts_at": {"type": ["string", "null"], "format": "date-time"}, "ends_at": {"type": ["string", "null"], "format": "date-time"},
    "repositories": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["repository", "milestone_number"],
      "properties": {"repository": {"type": "string", "pattern": "^[^/\\s]+/[^/#\\s]+$"}, "milestone_number": {"type": "integer", "minimum": 1}}}},
    "counting_units": {"type": "array", "items": {"type": "object", "required": ["issue", "planned_points", "work_type", "parent"],
      "properties": {"issue": {"type": "string", "pattern": "^[^/\\s]+/[^#\\s]+#[1-9][0-9]*$"}, "planned_points": {"type": "integer", "minimum": 1},
        "work_type": {"type": "string", "minLength": 1}, "parent": {"type": ["string", "null"]}}}}
  }
}
