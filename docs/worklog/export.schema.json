{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tadeumendonca.dev/schemas/worklog-export-v1.json",
  "title": "Retained tracker export v1",
  "type": "object",
  "required": ["schema_version", "cutoff", "repositories", "prior_inventory", "comments"],
  "properties": {
    "schema_version": {"const": 1}, "cutoff": {"type": "string", "format": "date-time"},
    "repositories": {"type": "array", "items": {"type": "object", "required": ["repository", "pagination_complete"]}},
    "prior_inventory": {"type": "object"},
    "comments": {"type": "array", "items": {"type": "object", "required": ["repository", "issue", "comment_id", "created_at", "updated_at", "body", "body_sha256"]}}
  }
}
